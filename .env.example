# ==============================================================================
# EDXSO Assignment 2: Harvey AI Sales Agent - Environment Configuration
# STRICT CONSTRAINT: ZERO PAID LLM APIS. ALL INFERENCE IS LOCAL VIA OLLAMA.
# ==============================================================================

# Server settings
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO

# Local SQLite Database
DATABASE_URL=sqlite:///./harvey_sales.db

# Ollama Local AI Inference
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_DEFAULT_MODEL=qwen2.5:3b
OLLAMA_FALLBACK_MODEL=qwen2.5:1.5b
OLLAMA_REQUEST_TIMEOUT=60

# Offline & Network Guardrails
# Set to 'true' to completely disable outbound web scraping and run 100% disconnected
OFFLINE_MODE=false
ALLOW_PUBLIC_WEB_RESEARCH=true
SCRAPE_REQUEST_TIMEOUT=10
USER_AGENT=HarveyLocalSalesAgent/2.0 (Permitted Research Bot; Respects robots.txt)

# Frontend URL for CORS
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# EMBEDDINGS (Local Sentence Transformers)
EMBEDDING_MODEL=all-MiniLM-L6-v2
